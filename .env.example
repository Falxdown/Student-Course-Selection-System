# Copy to .env and change every secret before exposing the service.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=campus_selection
MYSQL_USER=campus
MYSQL_PASSWORD=change-me-db
RABBITMQ_USER=campus
RABBITMQ_PASSWORD=change-me-mq

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters-2026
DEMO_DATA_ENABLED=true
